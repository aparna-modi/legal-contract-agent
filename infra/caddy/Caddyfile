# Production Caddyfile for Legal Contract Agent on Vultr
# - Automatic Let's Encrypt TLS 1.2/1.3 & HTTP -> HTTPS redirect
# - Works with a custom domain (e.g. legal.example.com) OR a free IP domain (<ip-with-dashes>.sslip.io)
# - Sticky ip_hash load balancing across backend-1 & backend-2 (keeps upload + SSE /events on the same worker)
# - Passive health checks + automatic failover on 502/503/504

{
	email {$ACME_EMAIL}
}

# Internal-only container healthcheck listener (never published to the host)
:8080 {
	handle /lb-health {
		header Content-Type application/json
		respond `{"status":"healthy","layer":"edge-caddy-tls-lb"}` 200
	}
}

{$APP_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 12MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	handle /lb-health {
		header Content-Type application/json
		respond `{"status":"healthy","layer":"edge-caddy-tls-lb"}` 200
	}

	@backend path /api/* /health /health/live /health/ready /metrics
	handle @backend {
		reverse_proxy backend-1:5000 backend-2:5000 {
			lb_policy ip_hash
			lb_try_duration 5s
			lb_try_interval 250ms
			fail_duration 30s
			max_fails 3
			unhealthy_status 502 503 504
			flush_interval -1
			transport http {
				dial_timeout 5s
				response_header_timeout 150s
			}
		}
	}

	handle {
		reverse_proxy frontend:80 {
			transport http {
				dial_timeout 5s
			}
		}
	}
}
