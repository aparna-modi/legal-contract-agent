PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/legal-contract-agent
JWT_SECRET=replace_with_a_long_random_64_char_secret

# Short-lived access token lifetime & rotating HttpOnly refresh token lifetime
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_TTL_DAYS=7

# Single or comma-separated AI worker pool URLs for round-robin load balancing + circuit breaker
AI_SERVICE_URL=http://127.0.0.1:8000
# AI_SERVICE_URLS=http://ai-service-1:8000,http://ai-service-2:8000

# Shared secret sent to AI service via X-Internal-Service-Key (must match ai-service INTERNAL_API_KEY)
# INTERNAL_API_KEY=replace_with_a_64_char_random_hex_secret

# Optional Redis for distributed rate limiting & caching across multiple backend replicas
# REDIS_URL=redis://127.0.0.1:6379

# Object Storage: local (dev default) | gridfs (MongoDB persistent, zero extra setup) | s3 (AWS S3, Cloudflare R2, MinIO)
# STORAGE_PROVIDER=gridfs
# S3_BUCKET=legal-contract-vault
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Optional transactional email (Resend) & observability (Sentry)
# RESEND_API_KEY=
# EMAIL_FROM="Legal Contract Agent <security@yourdomain.com>"
# APP_URL=http://localhost:5173
# SENTRY_DSN=

# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
