# ==============================================================================
# Legal Contract Agent — Vultr Production Environment (.env.vultr)
# ==============================================================================
# Copy this file to .env.vultr on your Vultr server (chmod 600 .env.vultr).
# NEVER commit .env.vultr to git!

# ------------------------------------------------------------------------------
# 1. Domain & Automatic HTTPS (Caddy + Let's Encrypt)
# ------------------------------------------------------------------------------
# Option A (Recommended): Your custom domain pointed via DNS A-record to Vultr IPv4
#   APP_DOMAIN=contracts.yourdomain.com
# Option B (No domain yet): Use free sslip.io with your Vultr IPv4 (replace dots with dashes)
#   APP_DOMAIN=203-0-113-10.sslip.io
APP_DOMAIN=replace-with-your-domain-or-ip.sslip.io

# Email used by Let's Encrypt for TLS certificate expiry notices
ACME_EMAIL=you@example.com

# Set to 2 only if proxying through Cloudflare (orange cloud); keep 1 for direct DNS / sslip.io
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# 2. Core Secrets (Copy from Render to keep existing users & sessions working)
# ------------------------------------------------------------------------------
# Keep your existing MongoDB Atlas URI for zero-downtime migration (whitelist Vultr IPv4 in Atlas!)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/legal-contract-agent?retryWrites=true&w=majority

# Copy exact JWT_SECRET from Render (or generate a 64-char hex secret: openssl rand -hex 32)
JWT_SECRET=replace_with_64_char_random_secret_copied_from_render
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_TTL_DAYS=7

# Shared backend <-> AI service secret (generate with: openssl rand -hex 32)
INTERNAL_API_KEY=replace_with_64_char_random_hex_secret

# ------------------------------------------------------------------------------
# 3. AI Service & Vector Store
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override (leave blank to use default fallback chain)
GEMINI_LLM_MODEL=

# Vector store options:
#   qdrant  -> Keep Render's Qdrant Cloud (set QDRANT_URL + QDRANT_API_KEY below)
#              OR self-host Qdrant on Vultr (set QDRANT_URL=http://qdrant:6333, leave QDRANT_API_KEY empty)
#   chroma  -> Embedded ChromaDB persisted in Docker volume chroma_data (zero external service)
VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# ------------------------------------------------------------------------------
# 4. File Storage (PDF / DOCX / TXT)
# ------------------------------------------------------------------------------
# gridfs -> Keeps all existing Render-uploaded files inside MongoDB (zero migration!)
# s3     -> Optional: Use Vultr Object Storage (S3-compatible) to offload PDFs from Atlas
STORAGE_PROVIDER=gridfs
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# 5. Auth, CORS, Email & Observability
# ------------------------------------------------------------------------------
# Leave COOKIE_SAMESITE=lax when Frontend & API are served from the same APP_DOMAIN
COOKIE_SAMESITE=lax
# Defaults automatically to https://${APP_DOMAIN}; set explicitly only if adding extra origins
# CORS_ORIGINS=https://contracts.yourdomain.com
# APP_URL=https://contracts.yourdomain.com

# Comma-separated emails granted platform-wide admin console access
PLATFORM_ADMIN_EMAILS=

# Optional Resend transactional email (password reset & team invites)
RESEND_API_KEY=
EMAIL_FROM=Legal Contract Agent <noreply@yourdomain.com>

# Optional Sentry error reporting
SENTRY_DSN=

# ------------------------------------------------------------------------------
# 6. Optional Self-Hosted MongoDB on Vultr (off by default — leave false to use Atlas)
# ------------------------------------------------------------------------------
ENABLE_SELFHOSTED_MONGO=false
MONGO_ROOT_USER=lca_admin
MONGO_ROOT_PASSWORD=
