{
  "name": "legal-contract-agent",
  "version": "1.0.0",
  "description": "Legal Contract Agent - AI-driven legal document and clause analysis",
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,AI,FRONTEND\" -c \"cyan.bold,magenta.bold,green.bold\" \"npm run backend:dev\" \"npm run ai:start\" \"npm run frontend\"",
    "start": "concurrently -k -n \"BACKEND,AI,FRONTEND\" -c \"cyan.bold,magenta.bold,green.bold\" \"npm run backend\" \"npm run ai:start\" \"npm run frontend\"",
    "backend": "npm --prefix backend start",
    "backend:dev": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:lint": "npm --prefix frontend run lint",
    "ai:start": "node -e \"const {spawn}=require('child_process'),fs=require('fs'),p=require('path'),d=p.join(process.cwd(),'ai-service'),py=[p.join(d,'.venv/Scripts/python.exe'),p.join(d,'.venv/bin/python')].find(fs.existsSync)||'python';spawn(py,['-m','uvicorn','main:app','--host','127.0.0.1','--port','8000','--reload'],{cwd:d,stdio:'inherit'}).on('exit',c=>process.exit(c||0))\"",
    "ai:test": "node -e \"const {spawn}=require('child_process'),fs=require('fs'),p=require('path'),d=p.join(process.cwd(),'ai-service'),py=[p.join(d,'.venv/Scripts/python.exe'),p.join(d,'.venv/bin/python')].find(fs.existsSync)||'python';spawn(py,['-m','pytest','-v'],{cwd:d,stdio:'inherit'}).on('exit',c=>process.exit(c||0))\"",
    "test:pipeline": "node -e \"const {spawn}=require('child_process'),fs=require('fs'),p=require('path'),d=p.join(process.cwd(),'ai-service'),py=[p.join(d,'.venv/Scripts/python.exe'),p.join(d,'.venv/bin/python')].find(fs.existsSync)||'python';spawn(py,['../scripts/verify_pipeline.py'],{cwd:d,stdio:'inherit'}).on('exit',c=>process.exit(c||0))\"",
    "eval:rag": "node -e \"const {spawn}=require('child_process'),fs=require('fs'),p=require('path'),d=p.join(process.cwd(),'ai-service'),py=[p.join(d,'.venv/Scripts/python.exe'),p.join(d,'.venv/bin/python')].find(fs.existsSync)||'python';spawn(py,['eval/evaluate_rag.py'],{cwd:d,stdio:'inherit'}).on('exit',c=>process.exit(c||0))\"",
    "eval:rag:offline": "node -e \"const {spawn}=require('child_process'),fs=require('fs'),p=require('path'),d=p.join(process.cwd(),'ai-service'),py=[p.join(d,'.venv/Scripts/python.exe'),p.join(d,'.venv/bin/python')].find(fs.existsSync)||'python';spawn(py,['eval/evaluate_rag.py','--offline'],{cwd:d,stdio:'inherit'}).on('exit',c=>process.exit(c||0))\"",
    "test:e2e": "node scripts/test_e2e.js",
    "test": "npm run ai:test && npm run test:pipeline && npm run test:e2e"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
