# Google Gemini API key (used for embeddings, grounded Q&A, summaries, OCR, and redlines)
GEMINI_API_KEY=your_gemini_api_key_here

# Shared service-to-service secret matching backend INTERNAL_API_KEY (required in production)
# INTERNAL_API_KEY=replace_with_a_64_char_random_hex_secret

# Vector store backend: chroma (embedded) | chroma-http | qdrant
# VECTOR_STORE_PROVIDER=chroma
# QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=
# CHROMA_HOST=chroma
# CHROMA_PORT=8001

# Runtime environment: development | production
# APP_ENV=development

# Comma-separated allowed CORS origins for internal gateway calls
# CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
